{
  "name": "syrve-loyalty-api",
  "version": "0.1.0",
  "description": "Syrve Loyalty API: Express 5 + PostgreSQL (Prisma) + Redis/BullMQ + Telegram (grammY)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node ./src/index.js",
    "dev": "nodemon src/index.js",
    "start:worker": "node ./src/workers/index.js",
    "dev:worker": "nodemon src/workers/index.js",
    "lint": "eslint src/**/*.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node ./prisma/seed.js"
  },
  "author": "Vitaliy Dyedukh <deduh83@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "grammy": "^1.32.0",
    "http-errors": "^2.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^9.26.0",
    "globals": "^16.1.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@6.0.0": true,
    "msgpackr-extract@3.0.7": true
  }
}
