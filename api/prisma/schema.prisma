// Prisma-схема — єдине джерело правди про структуру БД.
// Зміни лише через міграції: npx prisma migrate dev --name <назва>.
//
// Принцип розподілу даних: баланс, картки й транзакції живуть у Syrve.
// Тут зберігаємо тільки те, чого в Syrve немає:
//   - зв'язок Telegram <-> гість Syrve,
//   - адміністраторів нашої панелі,
//   - журнал ручних операцій,
//   - стан синхронізації транзакцій (щоб не дублювати сповіщення).

generator client {
  provider = "prisma-client-js"
  // native — для Windows-машини розробника,
  // debian-openssl-3.0.x — для образу node:22-slim у Docker.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperationType {
  topup
  chargeoff
}

enum OperationStatus {
  success
  failed
}

/// Адміністратор панелі. Створюється сід-скриптом із .env.
model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  login        String   @unique @db.VarChar(64)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  operations Operation[]

  @@map("admins")
}

/// Гість: зв'язок Telegram-акаунта з гостем у Syrve Loyalty.
/// Ім'я, баланс і картка — у Syrve; тут лише ключі й курсор синхронізації.
model Guest {
  id String @id @default(uuid()) @db.Uuid

  // Telegram. Id користувача й чату — int64, тому BigInt.
  telegramId BigInt  @unique @map("telegram_id")
  chatId     BigInt  @map("chat_id")

  // Заповнюються під час реєстрації (О2), тому nullable:
  // гість спершу натискає /start, потім ділиться контактом і вводить ім'я.
  phone           String? @unique @db.VarChar(20)
  name            String? @db.VarChar(100)
  syrveCustomerId String? @unique @map("syrve_customer_id") @db.Uuid
  cardNumber      String? @map("card_number") @db.VarChar(32)

  // Курсор для customer/transactions/by_revision: метод працює для ОДНОГО
  // гостя, тому revision зберігається окремо для кожного.
  lastRevision BigInt @default(0) @map("last_revision")

  // Гість заблокував бота: Telegram повертає 403, і далі писати йому
  // немає сенсу. Поллер такого гостя пропускає, доки він знову не напише /start.
  botBlockedAt DateTime? @map("bot_blocked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  operations             Operation[]
  processedTransactions  ProcessedTransaction[]

  @@index([createdAt])
  @@map("guests")
}

/// Журнал ручних нарахувань і списань (О5): хто, коли, скільком, чому.
/// Пишемо і невдалі спроби — інакше не видно, що адміністратор узагалі робив.
model Operation {
  id      String @id @default(uuid()) @db.Uuid
  adminId String @map("admin_id") @db.Uuid

  // Гість у Syrve — головний ключ операції: адміністратор може працювати
  // і з гостем, який ніколи не відкривав нашого бота.
  syrveCustomerId String  @map("syrve_customer_id") @db.Uuid
  // Заповнено, лише якщо гість зареєстрований через бот.
  guestId         String? @map("guest_id") @db.Uuid

  type      OperationType
  amount    Decimal         @db.Decimal(10, 2)
  reason    String          @db.VarChar(255)
  status    OperationStatus @default(success)
  error     String?
  createdAt DateTime        @default(now()) @map("created_at")

  // Restrict: журнал операцій не можна втратити разом із гостем
  // або адміністратором — це аудит.
  admin Admin  @relation(fields: [adminId], references: [id], onDelete: Restrict)
  guest Guest? @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@index([syrveCustomerId, createdAt])
  @@index([guestId, createdAt])
  @@index([adminId, createdAt])
  @@map("operations")
}

/// Транзакції Syrve, які поллер уже побачив (О6).
/// transactionId unique — головний захист від дубля сповіщення:
/// навіть якщо та сама транзакція прийде двічі, вставка впаде на unique.
model ProcessedTransaction {
  id            String    @id @default(uuid()) @db.Uuid
  transactionId String    @unique @map("transaction_id") @db.VarChar(64)
  guestId       String    @map("guest_id") @db.Uuid
  revision      BigInt
  // Syrve повертає числовий код (type) і назву (typeName): 35/RefillWalletFromApi,
  // 40/WithdrawWalletFromApi. Зберігаємо обидва: код — для мапінгу, назву —
  // щоб журнал можна було читати очима.
  type          String    @db.VarChar(64)
  typeName      String?   @map("type_name") @db.VarChar(64)
  sum           Decimal   @db.Decimal(14, 2)
  // Може бути null: у транзакціях, які не змінюють баланс (SetGuestCategory),
  // Syrve віддає balanceAfter = null.
  balanceAfter  Decimal?  @map("balance_after") @db.Decimal(14, 2)
  // Коли сповіщення реально відправлено. NULL = транзакція врахована,
  // але повідомлення ще не доставлено (задача в черзі або впала).
  notifiedAt    DateTime? @map("notified_at")
  // Текст останньої невдачі відправки — щоб було видно, чому не дійшло.
  notifyError   String?   @map("notify_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId, revision])
  @@map("processed_transactions")
}

// ---------------------------------------------------------------------------
// Мок-режим (SYRVE_MODE=mock): імітація сховища Syrve, щоб сервіс можна було
// запустити й показати без доступу до Syrve (вимога ТЗ, розділ 6).
//
// Чому окремі таблиці, а не пам'ять процесу: api і worker — два різні процеси.
// Нарахування робить api, а поллер сповіщень живе у worker. У пам'яті вони
// одне одного не побачили б, і О6 у мок-режимі не працювала б.
// Ці таблиці — "чужі" дані: сервіс до них звертається ТІЛЬКИ через мок-клієнт.
// ---------------------------------------------------------------------------

/// Гість у мок-Syrve. Його id грає роль syrveCustomerId.
model MockCustomer {
  id         String   @id @default(uuid()) @db.Uuid
  phone      String   @unique @db.VarChar(20)
  name       String   @db.VarChar(100)
  cardNumber String?  @map("card_number") @db.VarChar(32)
  cardTrack  String?  @map("card_track") @db.VarChar(32)
  inProgram  Boolean  @default(false) @map("in_program")
  balance    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  transactions MockTransaction[]

  @@map("mock_customers")
}

/// Транзакція в мок-Syrve. revision — монотонний лічильник у межах гостя,
/// як у customer/transactions/by_revision.
model MockTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  revision     BigInt
  type         String   @db.VarChar(64)
  typeName     String   @map("type_name") @db.VarChar(64)
  sum          Decimal  @db.Decimal(14, 2)
  // Nullable, бо так поводиться живий Syrve: у транзакціях, що не змінюють
  // баланс (SetGuestCategory), balanceAfter приходить null. Без цього мок
  // не міг би зобразити таку транзакцію взагалі.
  balanceAfter Decimal? @map("balance_after") @db.Decimal(14, 2)
  comment      String?  @db.VarChar(255)
  whenCreated  DateTime @default(now()) @map("when_created")

  customer MockCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, revision])
  @@index([customerId, revision])
  @@map("mock_transactions")
}
