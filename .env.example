# Скопіюй у .env і заповни значення. .env у .gitignore — у репозиторій не потрапляє.

# ---------- HTTP ----------
PORT=
# Адреса API для адмін-панелі (Vite)
VITE_API_URL=

# Порт панелі адміністратора в docker compose (nginx)
ADMIN_PORT=

# ---------- Логи ----------
# fatal|error|warn|info|debug|trace
LOG_LEVEL=
# true — читабельний вивід через pino-pretty (для локальної розробки)
LOG_PRETTY=

# ---------- Syrve ----------
# mock — фейковий клієнт без доступу до Syrve; real — справжній Syrve Cloud API
SYRVE_MODE=mock
SYRVE_API_URL=https://api-eu.syrve.live
# Ключ доступу до API (видає Syrve). СЕКРЕТ — тільки тут, не в коді й не в логах.
SYRVE_API_LOGIN=
# UUID організації. Порожньо — візьметься перша доступна.
SYRVE_ORGANIZATION_ID=
# UUID програми лояльності. Порожньо — візьметься перша активна, але в
# тестовій організації активних програм ЧОТИРИ, тому id треба задавати явно:
# інакше бонуси можуть піти в гаманець не тієї програми.
SYRVE_PROGRAM_ID=

# ---------- PostgreSQL ----------
# Ці змінні читає і docker compose (контейнер postgres), і DATABASE_URL нижче.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Приклад: postgresql://postgres:postgres@localhost:5432/syrve_loyalty?schema=public
# У docker compose host замінюється на "postgres".
DATABASE_URL=

# ---------- Redis / BullMQ ----------
REDIS_HOST=
REDIS_PORT=

# ---------- Авторизація в адмін-панелі ----------
JWT_SECRET=
# Адміністратор, якого створює сід (npm run seed у папці api/)
ADMIN_LOGIN=
ADMIN_PASSWORD=

# ---------- Telegram ----------
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=

# ---------- Поллер транзакцій (О6) ----------
# Період опитування Syrve, секунди
POLL_INTERVAL_SEC=30
