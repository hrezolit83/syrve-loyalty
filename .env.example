# ---------- Syrve ----------
# mock — фейковий клієнт без доступу до Syrve; real — справжній Syrve Cloud API
SYRVE_MODE=mock
SYRVE_API_URL=https://api-eu.syrve.live
# Логін доступу до API (видає Syrve)
SYRVE_API_LOGIN=
# UUID організації
SYRVE_ORGANIZATION_ID=
# UUID програми лояльності
SYRVE_PROGRAM_ID=

# ---------- PostgreSQL ----------
# Ці змінні читає і docker compose (для контейнера postgres), і DATABASE_URL нижче.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Приклад: postgresql://postgres:postgres@localhost:5432/syrve_loyalty?schema=public
# У docker compose host замінюється на "postgres".
DATABASE_URL=

# ---------- Redis / BullMQ ----------
REDIS_HOST=
REDIS_PORT=

# ---------- Авторизація ----------
JWT_SECRET=
# Адміністратор, якого створює сід
ADMIN_LOGIN=
ADMIN_PASSWORD=

# ---------- Telegram ----------
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=

# ---------- Поллер транзакцій (О6) ----------
# Період опитування Syrve, секунди
POLL_INTERVAL_SEC=30
